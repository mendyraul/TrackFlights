# Shared secrets remain in .env. Copy these overrides to .env.aeroapi.
FLIGHT_PROVIDER=flightaware
FLIGHT_API_BASE_URL=https://aeroapi.flightaware.com/aeroapi
# Worker checks persisted windows; five morning boards after 04:00 Miami time; regional snapshot after 12 UTC daily.
POLL_INTERVAL_SECONDS=900
AEROAPI_MONTHLY_BUDGET_USD=9.50
AEROAPI_SEARCH_COST_PER_PAGE_USD=0.05
AEROAPI_BOARD_COST_PER_PAGE_USD=0.005
AEROAPI_MAX_PAGES=1
# Client-side pacing: result sets (pages) per rolling minute across all AeroAPI calls.
# Bursting the ten morning boards gets HTTP 429, and failed windows are not retried.
AEROAPI_RESULT_SETS_PER_MINUTE=6
AEROAPI_BBOX=24.3,-83.0,28.7,-79.8
WEATHER_ENABLED=false
# Ledger shared by all AeroAPI calls. Do not delete/reset mid-month.
AEROAPI_BUDGET_STATE_PATH=.state/aeroapi_budget.json
