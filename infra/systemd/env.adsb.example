# Per-unit overrides for mia-ingestor-adsb.service — copy to <repo>/.env.adsb
# Loaded AFTER the shared .env, so values here win.
FLIGHT_PROVIDER=adsb1090
POLL_INTERVAL_SECONDS=15
# Point at the PiAware/dump1090 host if it is a different machine.
ADSB_JSON_URL=http://127.0.0.1:8080/data/aircraft.json
# This unit owns weather ingestion; the AeroAPI unit reads it from the DB.
WEATHER_ENABLED=true
PREDICTIONS_ENABLED=false
ANOMALY_DETECTION_ENABLED=false
# Optional dead-man's switch: a healthchecks.io (or similar) check URL. The
# ingestor pings it at most once a minute while the radio hears aircraft; if
# the pings stop (ingestor down, decoder down, or antenna/SDR unplugged) the
# service alerts you.
# HEARTBEAT_PING_URL=https://hc-ping.com/<your-check-uuid>

# ── Track log: local position history for training the phase classifier ──
# Empty = off. Point it at the SD card or a USB drive, e.g.
#   /home/<user>/trackflights/tracks.db   or   /mnt/usb/tracks.db
# Measured on a simulated busy hour: ~37 MB/day at 150 aircraft and 30 s
# sampling (less overnight). After an hour of logging, check the real rate:
#   python -m src.tools.track_log_stats /path/to/tracks.db 1024
# TRACK_LOG_PATH=
# One row per aircraft per this many seconds
TRACK_LOG_SAMPLE_SECONDS=30
# Delete rows older than this
TRACK_LOG_RETENTION_DAYS=30
# Hard cap on the file; the oldest day is dropped first
TRACK_LOG_MAX_MB=1024
# Pause writing while the disk has less than this free
TRACK_LOG_MIN_FREE_MB=1024
