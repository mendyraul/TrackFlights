# TrackFlights edge ETL configuration. Copy to .env and fill in.

# --- Supabase (required) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key (write access; bypasses RLS). Keep this secret — Pi only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Ingestion mode ---
# stream = positions model (tracked_flights + flight_positions); requires adsb1090.
INGEST_MODE=stream
FLIGHT_PROVIDER=adsb1090

# --- Local ADS-B decoder feed ---
ADSB_JSON_URL=http://127.0.0.1:8080/data/aircraft.json
ADSB_MAX_RANGE_KM=200
ADSB_MAX_SEEN_SECONDS=60

# --- Streaming throttle/batch (tuned for Pi 3 + free-tier Supabase) ---
STREAM_READ_INTERVAL_SECONDS=1
POSITION_THROTTLE_SECONDS=12
FLUSH_INTERVAL_SECONDS=20
BATCH_MAX_ROWS=500
POSITIONS_RETENTION_HOURS=12
TRACKED_STALE_MINUTES=30

# --- Receiver station ---
STATION_ID=pi-station-01
STATION_REFRESH_SECONDS=300
# If GPS is disabled, set static coordinates so positions carry a station fix:
# STATION_LAT=25.79325
# STATION_LON=-80.29056
# STATION_ALT_M=3

# --- u-blox GPS HAT (auto station location). Enable after wiring the HAT. ---
GPS_ENABLED=false
GPS_SERIAL_PORT=/dev/serial0
GPS_BAUD=9600

# --- Logging ---
LOG_LEVEL=INFO
