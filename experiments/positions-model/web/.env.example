# Public Supabase vars required by the web app (safe to expose; anon key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: server-side CDN cache windows (seconds). Higher = lower Supabase egress.
# SNAPSHOT_REFRESH_SECONDS=30
# TRAIL_REFRESH_SECONDS=15
