# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Flight API (AviationStack or FlightAware AeroAPI)
FLIGHT_API_KEY=your-flight-api-key
FLIGHT_API_BASE_URL=https://api.aviationstack.com/v1

# Provider: "aviationstack", "flightaware", "example" (mock data), or "adsb1090" (self-hosted ADS-B)
FLIGHT_PROVIDER=aviationstack

# For FlightAware AeroAPI, switch to:
# FLIGHT_PROVIDER=flightaware
# FLIGHT_API_BASE_URL=https://aeroapi.flightaware.com/aeroapi

# ADS-B (self-hosted): local readsb/dump1090 aircraft.json feed on the Pi.
# Used only when FLIGHT_PROVIDER=adsb1090. See docs/hardware-adsb-ingest.md + docs/etl-pipeline.md.
ADSB_JSON_URL=http://127.0.0.1:8080/data/aircraft.json
ADSB_MAX_RANGE_KM=200
ADSB_MIN_MOVE_METERS=150
ADSB_MAX_SEEN_SECONDS=60

# Ingestion
POLL_INTERVAL_SECONDS=10800
MIA_IATA_CODE=MIA
MIA_ICAO_CODE=KMIA

# Weather (Open-Meteo is free, no key required)
WEATHER_ENABLED=true
WEATHER_PROVIDER=openmeteo
WEATHER_POLL_INTERVAL_SECONDS=10800

# ML / Predictions (write-heavy; keep off on free tier)
PREDICTIONS_ENABLED=false
ANOMALY_DETECTION_ENABLED=false

# Retention (days)
FLIGHTS_HISTORY_RETENTION_DAYS=7
WEATHER_RETENTION_DAYS=3
ANOMALIES_RETENTION_DAYS=7

# Web snapshot route: how often the server re-reads Supabase (edge-cached for all
# viewers). Drives Supabase egress — see docs/cost-guardrails.md. 30-60s recommended.
SNAPSHOT_REFRESH_SECONDS=30

# Optional: Sentry
SENTRY_DSN=
