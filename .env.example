# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Flight API (AviationStack, FlightAware, ADS-B Exchange, etc.)
FLIGHT_API_KEY=your-flight-api-key
FLIGHT_API_BASE_URL=https://api.aviationstack.com/v1

# Provider: "aviationstack", "example" (mock data), "adsb1090" (self-hosted
# ADS-B), or "flightaware" (AeroAPI airport boards)
FLIGHT_PROVIDER=aviationstack

# FlightAware AeroAPI (FLIGHT_PROVIDER=flightaware). Set
#   FLIGHT_API_BASE_URL=https://aeroapi.flightaware.com/aeroapi
# and FLIGHT_API_KEY to your AeroAPI key. The budget guard halts polling for
# the month once projected spend reaches the budget; verify the real per-query
# price on the FlightAware portal usage page and recalibrate.
AEROAPI_MONTHLY_BUDGET_USD=9.0
AEROAPI_COST_PER_QUERY_USD=0.02
AEROAPI_MAX_PAGES=1
# AEROAPI_BUDGET_STATE_PATH=/path/to/.state/aeroapi_budget.json

# ADS-B (self-hosted): local readsb/dump1090 aircraft.json feed on the Pi.
# Used only when FLIGHT_PROVIDER=adsb1090. See docs/hardware-adsb-ingest.md + docs/etl-pipeline.md.
ADSB_JSON_URL=http://127.0.0.1:8080/data/aircraft.json
ADSB_MAX_RANGE_KM=200
ADSB_MIN_MOVE_METERS=150
ADSB_MAX_SEEN_SECONDS=60

# Ingestion
POLL_INTERVAL_SECONDS=10800
MIA_IATA_CODE=MIA
MIA_ICAO_CODE=KMIA
# How long the ingestor serves flights_current reads from its in-process cache
# before reconciling from the DB (reads from the Pi count as Supabase egress).
CURRENT_CACHE_REFRESH_SECONDS=600

# Weather (Open-Meteo is free, no key required)
WEATHER_ENABLED=true
WEATHER_PROVIDER=openmeteo
WEATHER_POLL_INTERVAL_SECONDS=10800

# ML / Predictions (write-heavy; keep off on free tier)
PREDICTIONS_ENABLED=false
ANOMALY_DETECTION_ENABLED=false

# Retention (days)
FLIGHTS_HISTORY_RETENTION_DAYS=7
WEATHER_RETENTION_DAYS=3
ANOMALIES_RETENTION_DAYS=7

# Web snapshot route: how often the server re-reads Supabase (edge-cached for all
# viewers). Drives Supabase egress — see docs/cost-guardrails.md.
SNAPSHOT_REFRESH_SECONDS=120
SUPABASE_SNAPSHOT_PAYLOAD_KB=35
# Dashboard summary route (weather + analytics + predictions + anomalies in
# one CDN-cached response). 300s keeps dashboard egress negligible.
DASHBOARD_SUMMARY_REFRESH_SECONDS=300

# Optional planning inputs for `npm run ops:supabase-free-tier`
SUPABASE_EXPECTED_DB_SIZE_MB=120
SUPABASE_EXPECTED_MONTHLY_ACTIVE_USERS=1000
SUPABASE_EXPECTED_MONTHLY_THIRD_PARTY_USERS=0
SUPABASE_EXPECTED_EDGE_FUNCTION_INVOCATIONS=0
SUPABASE_EXPECTED_PEAK_REALTIME_CONNECTIONS=25
SUPABASE_EXPECTED_REALTIME_MESSAGES_PER_MONTH=0
SUPABASE_EXPECTED_STORAGE_SIZE_MB=120

# Optional: Sentry
SENTRY_DSN=
